DATABASE_URL="file:./data/dev.db"
PORT=4000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Only needed if OPENAI_API_KEY was issued by an OpenAI-compatible gateway
# (e.g. OpenRouter) rather than OpenAI directly. Leave unset for a real
# OpenAI key — the SDK defaults to the standard OpenAI endpoint.
OPENAI_BASE_URL=
